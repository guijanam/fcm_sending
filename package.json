{
  "name": "dia-fcm-admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:server": "npm --prefix functions test",
    "test:config": "node --test scripts/config.test.mjs",
    "test:e2e": "playwright test",
    "test:emulator": "firebase emulators:exec --project demo-fcm-admin --only firestore \"node --test scripts/rules.test.mjs functions/test/firestore.integration.js\"",
    "check": "npm test && npm run test:server && npm run build",
    "deploy:functions": "firebase deploy --only functions:fcm-admin --project mydia-29ac2",
    "emulators": "firebase emulators:start --project demo-fcm-admin --only auth,functions,firestore"
  },
  "dependencies": {
    "firebase": "13.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.58.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "firebase-tools": "15.34.2",
    "jsdom": "^28.0.0",
    "typescript": "^6.0.0",
    "vite": "8.3.5",
    "vitest": "^4.0.0"
  }
}
